{
  "manifest_version": 3,
  "name": "Moha VPN",
  "version": "1.0.0",
  "description": "VPN subscription manager for Chrome",

  "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
  },

  "permissions": [
    "proxy",
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}